# /etc/default/lumora-relay — environment for lumora-relay.service
LUMORA_RELAY_LISTEN=127.0.0.1:8443
LUMORA_RELAY_TRUST_PROXY=true
LUMORA_RELAY_STUN_PORT=3478
# Native TLS instead of a reverse proxy (cert files must be readable by the service):
# LUMORA_RELAY_LISTEN=0.0.0.0:443
# LUMORA_RELAY_TRUST_PROXY=false
# LUMORA_RELAY_TLS_CERT=/etc/lumora-relay/fullchain.pem
# LUMORA_RELAY_TLS_KEY=/etc/lumora-relay/privkey.pem
# LUMORA_RELAY_MAX_CLIENTS=10000
# LUMORA_RELAY_BANDWIDTH=2097152
# LUMORA_RELAY_ALLOW=/etc/lumora-relay/allow.txt
RUST_LOG=info
