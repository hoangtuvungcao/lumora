# Copy to .env (install-vps.sh does this for you).

# Public DNS name pointing at this server (A/AAAA record). Without a domain you can
# use <your-ip>.sslip.io, e.g. 203.0.113.7.sslip.io
DOMAIN=relay.example.com

# Published UDP port of the built-in STUN responder.
STUN_PORT=3478

# ---- optional relay limits (defaults shown) --------------------------------
# LUMORA_RELAY_MAX_CLIENTS=10000
# LUMORA_RELAY_BANDWIDTH=2097152        # DATA bytes/s per client
# LUMORA_RELAY_BURST=4194304
# LUMORA_RELAY_SIGNAL_RATE=20           # SIGNAL frames/s per client
# LUMORA_RELAY_IDLE_TIMEOUT=90
# LUMORA_RELAY_MAILBOX=true
# LUMORA_RELAY_MAILBOX_TOTAL=268435456  # bytes
# LUMORA_RELAY_MAILBOX_TTL=604800       # seconds
# LUMORA_RELAY_ALLOW=/data/allow.txt    # private relay: put the file in the relay-data volume
# LUMORA_RELAY_LOG_JSON=false
# RUST_LOG=info
