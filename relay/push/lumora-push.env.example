# App Store Connect › Users and Access › Integrations › Keys: an "Apple Push Notifications service (APNs)" key.
LUMORA_PUSH_APNS_KEY=/keys/AuthKey.p8
LUMORA_PUSH_APNS_KEY_ID=ABCDE12345
LUMORA_PUSH_TEAM_ID=TEAM123456
# Bundle id of YOUR build of the app (the APNs topic). Comma-separate several.
LUMORA_PUSH_TOPIC=vn.lumora.lumora
