{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Lumora design tokens - single source of truth for the Flutter app and the website. Values are W3C-DTCG style ({ $value, $type }).",
  "meta": {
    "name": "Lumora",
    "version": "1.0.0",
    "tagline": {
      "vi": "Kết nối trực tiếp. Riêng tư tuyệt đối.",
      "en": "Direct. Private. Yours."
    }
  },
  "color": {
    "brand": {
      "violet": {
        "$value": "#6C5CE7",
        "$type": "color",
        "$description": "Lumora Violet - primary, rgb(108,92,231)"
      },
      "violet-600": {
        "$value": "#5A4BD6",
        "$type": "color",
        "$description": "Hover/pressed primary; AA on white text 6.15:1"
      },
      "violet-300": {
        "$value": "#A29BFE",
        "$type": "color",
        "$description": "Primary as text/icon on dark backgrounds (7.8:1 on #0F1020)"
      },
      "cyan": {
        "$value": "#00C2D1",
        "$type": "color",
        "$description": "Aurora Cyan - accent, rgb(0,194,209). Never as text on light bg."
      },
      "cyan-700": {
        "$value": "#0E7C86",
        "$type": "color",
        "$description": "Accent as text on light backgrounds (4.7:1)"
      },
      "gradient": {
        "$value": "linear-gradient(135deg, #6C5CE7 0%, #00C2D1 100%)",
        "$type": "gradient"
      }
    },
    "status": {
      "success": {
        "$value": "#22C55E",
        "$type": "color"
      },
      "warning": {
        "$value": "#F59E0B",
        "$type": "color"
      },
      "danger": {
        "$value": "#EF4444",
        "$type": "color"
      }
    },
    "light": {
      "bg": {
        "$value": "#F7F8FC",
        "$type": "color"
      },
      "surface": {
        "$value": "#FFFFFF",
        "$type": "color"
      },
      "surface-2": {
        "$value": "#EEF0F8",
        "$type": "color"
      },
      "border": {
        "$value": "#E1E4F0",
        "$type": "color"
      },
      "text": {
        "$value": "#14162B",
        "$type": "color"
      },
      "muted": {
        "$value": "#5B607D",
        "$type": "color"
      },
      "primary": {
        "$value": "#6C5CE7",
        "$type": "color"
      },
      "on-primary": {
        "$value": "#FFFFFF",
        "$type": "color"
      },
      "link": {
        "$value": "#5A4BD6",
        "$type": "color"
      },
      "accent-text": {
        "$value": "#0E7C86",
        "$type": "color"
      },
      "focus-ring": {
        "$value": "#6C5CE7",
        "$type": "color"
      }
    },
    "dark": {
      "bg": {
        "$value": "#0F1020",
        "$type": "color"
      },
      "surface": {
        "$value": "#171A2E",
        "$type": "color"
      },
      "surface-2": {
        "$value": "#1F2340",
        "$type": "color"
      },
      "border": {
        "$value": "#2A2F52",
        "$type": "color"
      },
      "text": {
        "$value": "#E8EAF6",
        "$type": "color"
      },
      "muted": {
        "$value": "#9AA0C3",
        "$type": "color"
      },
      "primary": {
        "$value": "#6C5CE7",
        "$type": "color"
      },
      "on-primary": {
        "$value": "#FFFFFF",
        "$type": "color"
      },
      "link": {
        "$value": "#A29BFE",
        "$type": "color"
      },
      "accent-text": {
        "$value": "#00C2D1",
        "$type": "color"
      },
      "focus-ring": {
        "$value": "#A29BFE",
        "$type": "color"
      }
    },
    "marketing": {
      "$description": "Website-only accents. Use sparingly; never in the app UI chrome.",
      "ivory": {
        "$value": "#FBF8F4",
        "$type": "color",
        "$description": "Warm light background for marketing pages"
      },
      "champagne": {
        "$value": "#E8C27A",
        "$type": "color",
        "$description": "Premium accent for 'free forever' badges only; text on light uses #7A5612"
      },
      "aurora-pink": {
        "$value": "#F472B6",
        "$type": "color",
        "$description": "Soft highlight inside aurora gradients / gradient text only"
      }
    }
  },
  "font": {
    "family": {
      "sans": {
        "$value": "'Be Vietnam Pro', system-ui, -apple-system, 'Segoe UI', Roboto, 'Noto Sans', sans-serif",
        "$type": "fontFamily"
      },
      "mono": {
        "$value": "ui-monospace, 'JetBrains Mono', 'SFMono-Regular', Menlo, Consolas, monospace",
        "$type": "fontFamily"
      }
    },
    "weight": {
      "regular": {
        "$value": 400,
        "$type": "fontWeight"
      },
      "medium": {
        "$value": 500,
        "$type": "fontWeight"
      },
      "semibold": {
        "$value": 600,
        "$type": "fontWeight"
      },
      "bold": {
        "$value": 700,
        "$type": "fontWeight"
      }
    },
    "scale": {
      "$description": "size / line-height / weight / letter-spacing (px)",
      "display": {
        "$value": {
          "size": 56,
          "lineHeight": 64,
          "weight": 700,
          "tracking": -1.2
        }
      },
      "h1": {
        "$value": {
          "size": 40,
          "lineHeight": 48,
          "weight": 700,
          "tracking": -0.8
        }
      },
      "h2": {
        "$value": {
          "size": 32,
          "lineHeight": 40,
          "weight": 700,
          "tracking": -0.5
        }
      },
      "h3": {
        "$value": {
          "size": 24,
          "lineHeight": 32,
          "weight": 600,
          "tracking": -0.2
        }
      },
      "title": {
        "$value": {
          "size": 18,
          "lineHeight": 26,
          "weight": 600,
          "tracking": 0
        }
      },
      "body-lg": {
        "$value": {
          "size": 18,
          "lineHeight": 28,
          "weight": 400,
          "tracking": 0
        }
      },
      "body": {
        "$value": {
          "size": 16,
          "lineHeight": 24,
          "weight": 400,
          "tracking": 0
        }
      },
      "body-sm": {
        "$value": {
          "size": 14,
          "lineHeight": 20,
          "weight": 400,
          "tracking": 0
        }
      },
      "caption": {
        "$value": {
          "size": 12,
          "lineHeight": 16,
          "weight": 500,
          "tracking": 0.2
        }
      },
      "overline": {
        "$value": {
          "size": 12,
          "lineHeight": 16,
          "weight": 600,
          "tracking": 1.2
        }
      }
    }
  },
  "radius": {
    "sm": {
      "$value": "8px",
      "$type": "dimension"
    },
    "md": {
      "$value": "12px",
      "$type": "dimension"
    },
    "lg": {
      "$value": "16px",
      "$type": "dimension"
    },
    "xl": {
      "$value": "24px",
      "$type": "dimension"
    },
    "full": {
      "$value": "9999px",
      "$type": "dimension"
    }
  },
  "space": {
    "$description": "4-pt scale",
    "0": {
      "$value": "0px",
      "$type": "dimension"
    },
    "1": {
      "$value": "4px",
      "$type": "dimension"
    },
    "2": {
      "$value": "8px",
      "$type": "dimension"
    },
    "3": {
      "$value": "12px",
      "$type": "dimension"
    },
    "4": {
      "$value": "16px",
      "$type": "dimension"
    },
    "5": {
      "$value": "20px",
      "$type": "dimension"
    },
    "6": {
      "$value": "24px",
      "$type": "dimension"
    },
    "8": {
      "$value": "32px",
      "$type": "dimension"
    },
    "10": {
      "$value": "40px",
      "$type": "dimension"
    },
    "12": {
      "$value": "48px",
      "$type": "dimension"
    },
    "16": {
      "$value": "64px",
      "$type": "dimension"
    },
    "20": {
      "$value": "80px",
      "$type": "dimension"
    },
    "24": {
      "$value": "96px",
      "$type": "dimension"
    }
  },
  "shadow": {
    "light": {
      "sm": {
        "$value": "0 1px 2px rgba(20,22,43,0.06), 0 1px 3px rgba(20,22,43,0.08)",
        "$type": "shadow"
      },
      "md": {
        "$value": "0 4px 12px rgba(20,22,43,0.08), 0 2px 4px rgba(20,22,43,0.04)",
        "$type": "shadow"
      },
      "lg": {
        "$value": "0 16px 40px rgba(20,22,43,0.12), 0 4px 12px rgba(20,22,43,0.06)",
        "$type": "shadow"
      },
      "glow": {
        "$value": "0 8px 32px rgba(108,92,231,0.28)",
        "$type": "shadow"
      }
    },
    "dark": {
      "sm": {
        "$value": "0 1px 2px rgba(0,0,0,0.4)",
        "$type": "shadow"
      },
      "md": {
        "$value": "0 4px 16px rgba(0,0,0,0.45)",
        "$type": "shadow"
      },
      "lg": {
        "$value": "0 20px 48px rgba(0,0,0,0.55)",
        "$type": "shadow"
      },
      "glow": {
        "$value": "0 8px 40px rgba(108,92,231,0.45)",
        "$type": "shadow"
      }
    }
  },
  "motion": {
    "duration": {
      "fast": {
        "$value": "120ms",
        "$type": "duration",
        "$description": "hover, press, toggles"
      },
      "base": {
        "$value": "200ms",
        "$type": "duration",
        "$description": "menus, tooltips, small transitions"
      },
      "slow": {
        "$value": "320ms",
        "$type": "duration",
        "$description": "dialogs, page/section transitions"
      }
    },
    "easing": {
      "standard": {
        "$value": [
          0.2,
          0,
          0,
          1
        ],
        "$type": "cubicBezier"
      },
      "decelerate": {
        "$value": [
          0,
          0,
          0,
          1
        ],
        "$type": "cubicBezier"
      },
      "accelerate": {
        "$value": [
          0.3,
          0,
          1,
          1
        ],
        "$type": "cubicBezier"
      }
    },
    "$description": "Honour prefers-reduced-motion / MediaQuery.disableAnimations: drop to 0ms."
  },
  "icon": {
    "stroke": {
      "$value": 1.75,
      "$type": "number",
      "$description": "Line icons on a 24px grid, round caps/joins"
    },
    "sizes": {
      "$value": [
        16,
        20,
        24,
        32
      ]
    }
  },
  "logo": {
    "minSize": {
      "mark": "16px",
      "lockup": "96px wide (digital) / 24mm (print)"
    },
    "clearSpace": "0.25 x mark height on every side"
  }
}