# Build outputs (CI rebuilds everything)
/core/target/
/core/target*/
/dist/
/app/build/
/app/.dart_tool/
/app/.flutter-plugins
/app/.flutter-plugins-dependencies
/app/android/app/src/main/jniLibs/**/*.so
/app/android/.gradle/
/app/android/build/
/app/android/.kotlin/
/app/android/app/.cxx/
/app/android/local.properties
/app/ios/Pods/
/app/macos/Pods/
**/node_modules/
**/__pycache__/
.mypy_cache/
.pytest_cache/
.ruff_cache/
*.pyc

# Screenshots and test artifacts (regenerated by tests, never committed)
/app/screenshots/
/branding/screenshots-landing/
/app/test/failures/
/core/tests/bin/
/core/fuzz/artifacts/
*.log

# Local data, keys and secrets — never commit
*.db
*.db-wal
*.db-shm
keystore.json
*.lumora-backup
*.p8
*.p12
*.pem
*.key
*.jks
*.keystore
*.mobileprovision
*.provisionprofile
.env
.env.*
*.env
# templates are tracked: copy lumora-*.env.example to lumora-*.env and fill it in
!*.env.example
/app/android/key.properties

# Editor / OS / tooling
.claude/
.vscode/
.idea/
.DS_Store
*.swp
*detect_compiler_family.o
